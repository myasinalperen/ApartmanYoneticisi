# ─── PIN ATAMALARI ────────────────────────────────────────────────
# PA0   WKUP butonu (input, pulldown)
PA0-WKUP.GPIO_Label=WKUP_BTN
PA0-WKUP.GPIO_PuPd=GPIO_PULLDOWN
PA0-WKUP.Signal=GPIO_Input

# PA2/PA3  USART2 – Telemetri / MAVLink (115200 baud)
PA2.Mode=Asynchronous
PA2.Signal=USART2_TX
PA3.Mode=Asynchronous
PA3.Signal=USART2_RX

# PA5/PA6/PA7  SPI1 – IMU + Barometre paylaşımlı bus
# Mode 3 (CPOL=1, CPHA=1) – MPU6050/ICM42688 & BMP280/MS5611 uyumlu
PA5.Mode=Full_Duplex_Master
PA5.Signal=SPI1_SCK
PA6.Mode=Full_Duplex_Master
PA6.Signal=SPI1_MISO
PA7.Mode=Full_Duplex_Master
PA7.Signal=SPI1_MOSI

# PA9/PA10  USART1 – GPS (115200 baud, DMA RX)
PA9.Mode=Asynchronous
PA9.Signal=USART1_TX
PA10.Mode=Asynchronous
PA10.Signal=USART1_RX

# PA11/PA12  USB OTG FS – Konfigürasyon / firmware güncelleme
PA11.Signal=USB_OTG_FS_DM
PA12.Signal=USB_OTG_FS_DP

# PA13/PA14  SWD – Debug/flash (JTAG devre dışı)
PA13.Mode=Serial_Wire
PA13.Signal=SYS_JTMS-SWDIO
PA14.Mode=Serial_Wire
PA14.Signal=SYS_JTCK-SWCLK

# PB6/PB7  I2C1 – Manyetometre (400 kHz)
PB6.Mode=I2C
PB6.Signal=I2C1_SCL
PB7.Mode=I2C
PB7.Signal=I2C1_SDA

# PB10/PB11  USART3 – RC alıcı SBUS (100000 baud, 8E2, ters çevrilmiş)
# NOT: SBUS sinyali ters mantık → harici inverter (74HC04) veya yazılım inversiyonu gerekli
PB10.Mode=Asynchronous
PB10.Signal=USART3_TX
PB11.Mode=Asynchronous
PB11.Signal=USART3_RX

# PB12  CS_SD – SD kart chip select (GPIO output, başlangıçta HIGH)
PB12.GPIO_Label=CS_SD
PB12.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PB12.GPIO_PuPd=GPIO_NOPULL
PB12.GPIO_Speed=GPIO_SPEED_FREQ_HIGH
PB12.Locked=true
PB12.Signal=GPIO_Output

# PB13/PB14/PB15  SPI2 – SD kart (Mode 0, 10.5 MHz)
PB13.Mode=Full_Duplex_Master
PB13.Signal=SPI2_SCK
PB14.Mode=Full_Duplex_Master
PB14.Signal=SPI2_MISO
PB15.Mode=Full_Duplex_Master
PB15.Signal=SPI2_MOSI

# PC0  VBAT_SENSE – Batarya voltaj bölücü → ADC1_IN10
PC0.GPIO_Label=VBAT_SENSE
PC0.Signal=ADC1_IN10

# PC1  CURR_SENSE – Akım sensörü (ACS712/ACS758) → ADC1_IN11
PC1.GPIO_Label=CURR_SENSE
PC1.Signal=ADC1_IN11

# PC4  CS_IMU – MPU6050/ICM42688 chip select
PC4.GPIO_Label=CS_IMU
PC4.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PC4.GPIO_PuPd=GPIO_NOPULL
PC4.GPIO_Speed=GPIO_SPEED_FREQ_HIGH
PC4.Locked=true
PC4.Signal=GPIO_Output

# PC5  CS_BARO – BMP280/MS5611 chip select
PC5.GPIO_Label=CS_BARO
PC5.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PC5.GPIO_PuPd=GPIO_NOPULL
PC5.GPIO_Speed=GPIO_SPEED_FREQ_HIGH
PC5.Locked=true
PC5.Signal=GPIO_Output

# PC6/PC7/PC8/PC9  TIM3_CH1-4 – Servo / Yardımcı PWM çıkışları (50 Hz)
PC6.Mode=PWM Generation CH1
PC6.Signal=TIM3_CH1
PC7.Mode=PWM Generation CH2
PC7.Signal=TIM3_CH2
PC8.Mode=PWM Generation CH3
PC8.Signal=TIM3_CH3
PC9.Mode=PWM Generation CH4
PC9.Signal=TIM3_CH4

# PD3  SD_CD – SD kart takılı dedektörü (input, pullup)
PD3.GPIO_Label=SD_CD
PD3.GPIO_PuPd=GPIO_PULLUP
PD3.Signal=GPIO_Input

# PD12  LED_STATUS – Yeşil durum LED'i
PD12.GPIO_Label=LED_STATUS
PD12.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PD12.GPIO_PuPd=GPIO_NOPULL
PD12.Locked=true
PD12.Signal=GPIO_Output

# PD13  LED_ERROR – Kırmızı hata LED'i
PD13.GPIO_Label=LED_ERROR
PD13.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PD13.GPIO_PuPd=GPIO_NOPULL
PD13.Locked=true
PD13.Signal=GPIO_Output

# PD14  BUZZER – TIM4_CH3 PWM tonu (1 kHz varsayılan)
PD14.GPIO_Label=BUZZER
PD14.Mode=PWM Generation CH3
PD14.Signal=TIM4_CH3

# PE0  IMU_INT – MPU6050/ICM42688 Data-Ready kesme pini (EXTI0, yükselen kenar)
PE0.GPIO_Label=IMU_INT
PE0.GPIO_PuPd=GPIO_NOPULL
PE0.Signal=GPXTI0

# PE9/PE11/PE13/PE14  TIM1_CH1-4 – Motor ESC PWM çıkışları (400 Hz)
# Motor sıralaması: M1=PE9 (ön-sol), M2=PE11 (ön-sağ), M3=PE13 (arka-sağ), M4=PE14 (arka-sol)
PE9.Mode=PWM Generation CH1 (for Advanced TIM)
PE9.Signal=TIM1_CH1
PE11.Mode=PWM Generation CH2 (for Advanced TIM)
PE11.Signal=TIM1_CH2
PE13.Mode=PWM Generation CH3 (for Advanced TIM)
PE13.Signal=TIM1_CH3
PE14.Mode=PWM Generation CH4 (for Advanced TIM)
PE14.Signal=TIM1_CH4

# PH0/PH1  HSE kristal osilatör (8 MHz)
PH0-OSC_IN.Signal=RCC_OSC_IN
PH1-OSC_OUT.Signal=RCC_OSC_OUT

