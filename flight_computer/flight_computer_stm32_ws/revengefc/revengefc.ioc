# ─── TIM1 – Motor ESC PWM çıkışları (APB2: 168 MHz timer clock) ──
# Prescaler=167 → 1 MHz sayaç | Period=2499 → 400 Hz PWM
# Darbe: 1000µs (arm) ~ 2000µs (tam gaz)
TIM1.Channel-PWM\ Generation\ CH1=TIM_CHANNEL_1
TIM1.Channel-PWM\ Generation\ CH2=TIM_CHANNEL_2
TIM1.Channel-PWM\ Generation\ CH3=TIM_CHANNEL_3
TIM1.Channel-PWM\ Generation\ CH4=TIM_CHANNEL_4
TIM1.ClockDivision=TIM_CLOCKDIVISION_DIV1
TIM1.CounterMode=TIM_COUNTERMODE_UP
TIM1.IPParameters=Channel-PWM Generation CH1,Channel-PWM Generation CH2,Channel-PWM Generation CH3,Channel-PWM Generation CH4,Period,Prescaler,ClockDivision,CounterMode
TIM1.Period=2499
TIM1.Prescaler=167

# ─── TIM3 – Servo PWM çıkışları (APB1: 84 MHz timer clock) ───────
# Prescaler=83 → 1 MHz sayaç | Period=19999 → 50 Hz PWM
# Darbe: 1000µs (0°) ~ 2000µs (180°)
TIM3.Channel-PWM\ Generation\ CH1=TIM_CHANNEL_1
TIM3.Channel-PWM\ Generation\ CH2=TIM_CHANNEL_2
TIM3.Channel-PWM\ Generation\ CH3=TIM_CHANNEL_3
TIM3.Channel-PWM\ Generation\ CH4=TIM_CHANNEL_4
TIM3.IPParameters=Channel-PWM Generation CH1,Channel-PWM Generation CH2,Channel-PWM Generation CH3,Channel-PWM Generation CH4,Period,Prescaler
TIM3.Period=19999
TIM3.Prescaler=83

# ─── TIM4 – Buzzer tonu (APB1: 84 MHz timer clock) ───────────────
# Prescaler=83 → 1 MHz | Period=999 → 1 kHz buzzer tonu
TIM4.Channel-PWM\ Generation\ CH3=TIM_CHANNEL_3
TIM4.IPParameters=Channel-PWM Generation CH3,Period,Prescaler
TIM4.Period=999
TIM4.Prescaler=83

# ─── USART1 – GPS alıcı (115200 baud, DMA RX) ────────────────────
USART1.BaudRate=115200
USART1.IPParameters=VirtualMode,BaudRate
USART1.VirtualMode=VM_ASYNC

# ─── USART2 – Telemetri / MAVLink / Debug (115200 baud) ──────────
USART2.BaudRate=115200
USART2.IPParameters=VirtualMode,BaudRate
USART2.VirtualMode=VM_ASYNC

# ─── USART3 – RC Alıcı SBUS (100000 baud, 8E2) ───────────────────
# SBUS protokolü: 100000 baud, 8 veri biti, Çift eşlik (Even), 2 dur biti
# STM32F4'te parity açıkken WordLength=9B gerekir (8 data + 1 parity = 9-bit frame)
# Harici inverter gerekli (SBUS mantık seviyesi terslenmiş, 74HC04 veya benzeri)
USART3.BaudRate=100000
USART3.IPParameters=VirtualMode,BaudRate,Parity,StopBits,WordLength
USART3.Parity=UART_PARITY_EVEN
USART3.StopBits=UART_STOPBITS_2
USART3.VirtualMode=VM_ASYNC
USART3.WordLength=UART_WORDLENGTH_9B

# ─── USB OTG FS – Cihaz modu (konfigürasyon / firmware güncelleme) ─
USB_OTG_FS.IPParameters=VirtualMode
USB_OTG_FS.VirtualMode=Device_Only

